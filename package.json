{
  "name": "mugs-obsidian",
  "version": "0.1.1",
  "description": "MUGS — Multi-User Git Sync for Obsidian. Fine-grained, folder-mapped git sync across all git backends (GitLab-first) with per-user credentials stored inside the vault.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.dev.js",
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.min.js",
    "manifest": "node scripts/manifest.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "vitest bench",
    "typecheck": "tsc --noEmit --skipLibCheck"
  },
  "keywords": [
    "obsidian",
    "git",
    "sync",
    "gitlab",
    "multi-user"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.7.5",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.24.0",
    "obsidian": "latest",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "dependencies": {
    "zod": "^3.24.1"
  }
}
